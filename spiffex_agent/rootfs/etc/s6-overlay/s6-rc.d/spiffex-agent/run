#!/command/with-contenv bashio
# shellcheck shell=bash
# Run the spiffex agent: it signs in to the issuer with this machine's key and serves the SPIFFE
# Workload API where Home Assistant Core finds it.
set -euo pipefail

readonly OPTIONS=/data/options.json
readonly KEY=/data/key.pem
# Home Assistant's configuration folder is /homeassistant here and /config in Core, so Core sees
# this socket as unix:///config/.spiffe/agent.sock.
readonly SOCKET_DIR=/homeassistant/.spiffe
readonly SOCKET="${SOCKET_DIR}/agent.sock"

option() {
  jq -r --arg name "$1" '.[$name] // "" | tostring' "${OPTIONS}"
}

issuer="$(option issuer)"
trust_domain="$(option trust_domain)"
client_id="$(option client_id)"
ca_file="$(option ca_file)"

missing=()
[[ -n "${issuer}" ]] || missing+=(issuer)
[[ -n "${trust_domain}" ]] || missing+=(trust_domain)
[[ -n "${client_id}" ]] || missing+=(client_id)
if ((${#missing[@]})); then
  bashio::log.fatal "Set these options on the Configuration tab first: ${missing[*]}"
  exit 1
fi

new_key() {
  # Write to a temporary name and rename, so a power cut never leaves a half-written key.pem.
  # `key generate` refuses to overwrite a file and writes it with mode 0600.
  rm -f "${KEY}.new"
  spiffex key generate -out "${KEY}.new" >/dev/null
  sync "${KEY}.new"
  mv "${KEY}.new" "${KEY}"
  sync /data
}

if [[ ! -e "${KEY}" ]]; then
  new_key
  bashio::log.notice "Generated a new private key for this machine."
elif ! spiffex key public -in "${KEY}" >/dev/null 2>&1; then
  # An unreadable key cannot sign in anywhere, so nothing is lost by replacing it. Keep the old
  # file for inspection.
  corrupt="${KEY}.unreadable-$(date +%Y%m%dT%H%M%S)"
  mv "${KEY}" "${corrupt}"
  new_key
  bashio::log.warning "The private key could not be read and was moved to ${corrupt}."
  bashio::log.warning "Generated a new one: admit it at the issuer in place of the old key."
fi

bashio::log.info "Admit this public key at the issuer as client ${client_id}:"
spiffex key public -in "${KEY}"

# The agent does not create the socket's directory. Keep it private to root even if it existed.
mkdir -p "${SOCKET_DIR}"
chmod 0700 "${SOCKET_DIR}"

args=(
  agent
  -issuer "${issuer}"
  -trust-domain "${trust_domain}"
  -client-id "${client_id}"
  -key-file "${KEY}"
  -socket "${SOCKET}"
)
if [[ -n "${ca_file}" ]]; then
  args+=(-ca-file "${ca_file}")
fi

bashio::log.info "Serving the Workload API at ${SOCKET} (unix:///config/.spiffe/agent.sock in Home Assistant)"
exec spiffex "${args[@]}"
